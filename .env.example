# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Frontend -> Local Python FastAPI Backend Configuration
VITE_API_BASE_URL="http://127.0.0.1:8000"

# Local Python FastAPI Server Configuration
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Local Ollama Configuration (Backend-only; NEVER expose directly to public internet or browser)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# Discover installed Qwen model tag via `ollama list` or GET http://127.0.0.1:11434/api/tags
# Optional documented initial value if installed: qwen2.5:3b (never silently substituted)
OLLAMA_CHAT_MODEL="qwen2.5:3b"
# Multilingual embedding model for semantic recall via POST /api/embed
OLLAMA_EMBED_MODEL="bge-m3"
OLLAMA_TIMEOUT_SECONDS="45"
# Maximum squared-L2 distance for semantic matches from local Ollama embeddings.
SEMANTIC_MAX_DISTANCE="1.12"

# Local Storage & Index Paths
SQLITE_DB_PATH="./backend/data/alquds_catalog.db"
CHROMA_PERSIST_DIR="./backend/data/chroma_index"
DATASET_ZIP_PATH="./alquds_expanded_dataset(1).zip"
DATASET_DIR_PATH="./backend/data/extracted_dataset"
VERIFIED_BYLAWS_DIR="./backend/data/verified_bylaws"

# University Portal Integration (Disabled / Read-Only Pending Institutional Authorization)
ENABLE_AUTHORIZED_PORTAL_ADAPTERS="false"
ALQUDS_STUDENT_PORTAL_LOGIN_URL="https://student.alquds.edu/en/login"
ALQUDS_LECTURER_PORTAL_LOGIN_URL="https://portal.alquds.edu/en/login"
PORTAL_SESSION_TTL_SECONDS="900"

